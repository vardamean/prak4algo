def is_kabisat(tahun):

    return (tahun % 4 == 0 and tahun % 100 != 0) or (tahun % 400 == 0)


while True:
    print("=" * 45)
    print(" PROGRAM PENENTU JUMLAH HARI DALAM BULAN ")
    print("=" * 45)
    

    bulan = int(input("Masukkan bulan (1-12): "))
    tahun = int(input("Masukkan tahun: "))
    

    if bulan in [1, 3, 5, 7, 8, 10, 12]:
        jumlah_hari = 31
    elif bulan in [4, 6, 9, 11]:
        jumlah_hari = 30
    elif bulan == 2:
        if is_kabisat(tahun):
            jumlah_hari = 29
        else:
            jumlah_hari = 28
    else:
        jumlah_hari = None
    
    # Menampilkan hasil
    if jumlah_hari is not None:
        print(f"\nHasil: Jumlah hari pada bulan {bulan} tahun {tahun} adalah {jumlah_hari} hari.\n")
    else:
        print("\nInput bulan tidak valid! Silakan masukkan angka 1 hingga 12.\n")

    ulang = input("Apakah ingin menghitung lagi? (y/n): ").lower()
    if ulang != 'y':
        print("\nTerima kasih telah menggunakan program ini!")
        break
